# ===== Runtime =====
NODE_ENV=production
PORT=8787

# ===== Public URLs =====
FRONTEND_URL=https://app.example.com
API_PUBLIC_URL=https://api.example.com
PUBLIC_BASE_URL=https://app.example.com
PUBLIC_API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com

# ===== Data =====
DATABASE_URL=postgres://timio:CHANGE_ME@postgres:5432/timio
REDIS_URL=redis://redis:6379

# ===== Email (required in production) =====
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=Timio <noreply@example.com>

# ===== Payments (required before paid subscriptions are enabled) =====
YOOKASSA_SHOP_ID=CHANGE_ME
YOOKASSA_SECRET_KEY=CHANGE_ME

# ===== Optional OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ===== Optional AI =====
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
YANDEXGPT_MODEL=
YANDEXGPT_BASE_URL=

# ===== Optional messaging =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_CONTENT_VARIABLES=

# ===== Workers =====
REMINDER_WORKER_INTERVAL_MS=60000
SUBSCRIPTION_CRON_INTERVAL_MS=3600000
WAITLIST_SWEEP_INTERVAL_MS=60000
WAITLIST_HOLD_MINUTES=30
